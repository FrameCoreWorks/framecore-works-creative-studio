    },
    {
      "id": "storyboard_board_fit",
      "owners": [
        "storyboard-board-architect"
      ],
      "artifact": "Board Artifact Prompt"
    },
    {
      "id": "copy_fit",
      "owners": [
        "copy-voice"
      ],
      "artifact": "Copy Pack"
    },
    {
      "id": "promptability_fit",
      "owners": [
        "image-prompting",
        "video-prompting"
      ],
      "artifact": "Prompt Pack"
    },
    {
      "id": "schema_pricing_fit",
      "owners": [
        "tool-routing-cost"
      ],
      "artifact": "Tool Routing Plan"
    },
    {
      "id": "execution_manifest_fit",
      "owners": [
        "execution-manifest",
        "hyperframes-producer"
      ],
      "artifact": "Execution Manifest or HyperFrames Production Brief"
    },
    {
      "id": "asset_manifest_fit",
      "owners": [
        "asset-manifest"
      ],
      "artifact": "Asset Manifest"
    },
    {
      "id": "post_execution_fit",
      "owners": [
        "qa-iteration"
      ],
      "artifact": "QA / Iteration Report"
    },
    {
      "id": "delivery_fit",
      "owners": [
        "delivery-documentation"
      ],
      "artifact": "Delivery Manifest"
    },
    {
      "id": "self_improvement_sufficiency_fit",
      "owners": [
        "workflow-orchestrator",
        "qa-iteration"
      ],
      "artifact": "Self-Improvement Sufficiency Gate"
    }
  ],
  "qa_by_modality": {
    "still": "output-critic-iteration",
    "video": "video-prompt-architect",
    "audio": "audio-production-director",
    "captions": "caption-studio"
  },
  "research_policy": {
    "scope": "every_new_substantive_creative_request",
    "role": "research-evidence",
    "gate": "evidence_fit",
    "triggers": [
      "named_tool_or_model",
      "platform_requirements",
      "public_claim",
      "capability_claim",
      "reference_or_verification_request",
      "real_world_subject"
    ],
    "untriggered_rule": "Stable craft on supplied or fictional facts needs no search and no research disclaimer; make no current-verification claim.",
    "unavailable_rule": "When triggered research is unavailable, including ChatGPT without search or Codex with network disabled, disclose briefly, keep mutable claims unverified and withhold only dependent artifacts.",
    "reuse_rule": "Reuse evidence only while the question and source basis are unchanged within the active project.",
    "no_browse_rule": "Honor explicit user no-browse boundaries, record the restriction, and keep mutable claims unverified."
  }
}
