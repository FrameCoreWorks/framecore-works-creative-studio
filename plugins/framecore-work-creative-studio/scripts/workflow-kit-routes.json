  "handoffs": [
    {
      "from": "intent-confirmation",
      "to": "workflow-orchestrator",
      "required_fields": "confirmed_goal, excluded_scope, work_mode, expected_output, immediate_next_step"
    },
    {
      "from": "workflow-orchestrator",
      "to": "brief-architect",
      "required_fields": "goal, raw_context, constraints, expected_artifact, request_diagnostic, reasoning_route when useful"
    },
    {
      "from": "workflow-orchestrator",
      "to": "asset-manifest",
      "required_fields": "existing_files, review_goal, acceptance_criteria, delivery_need, source_notes"
    },
    {
      "from": "workflow-orchestrator",
      "to": "instruction-packet-factory",
      "required_fields": "target_role, packet_type, context, goal, exclusions, output_need, reasoning_route, selected_methods, stop_condition"
    },
    {
      "from": "workflow-orchestrator",
      "to": "qa-iteration",
      "required_fields": "loop_state, artifacts_under_review, acceptance_matrix, regression_scope, stop_condition"
    },
    {
      "from": "instruction-packet-factory",
      "to": "research-evidence",
      "required_fields": "packet_id, goal, source_rules, acceptance_criteria, output_schema, verification_questions"
    },
    {
      "from": "instruction-packet-factory",
      "to": "reference-curator",
      "required_fields": "packet_id, reference_goals, suppression_rules, output_schema, source_notes_need"
    },
    {
      "from": "brief-architect",
      "to": "reference-curator",
      "required_fields": "brief_contract, reference_needs, constraints"
    },
    {
      "from": "brief-architect",
      "to": "research-evidence",
      "required_fields": "brief_contract, research_questions, source_rules"
    },
    {
      "from": "brief-architect",
      "to": "instruction-packet-factory",
      "required_fields": "brief_contract, target_role, packet_type, constraints, exclusions, acceptance_criteria"
    },
    {
      "from": "brief-architect",
      "to": "delivery-documentation",
      "required_fields": "brief_contract, accepted_scope, delivery_notes"
    },
    {
      "from": "reference-curator",
      "to": "static-direction",
      "required_fields": "reference_pack, continuity_anchors, suppression_rules"
    },
    {
      "from": "reference-curator",
      "to": "motion-direction",
      "required_fields": "reference_pack, continuity_anchors, suppression_rules"
    },
    {
      "from": "research-evidence",
      "to": "copy-voice",
      "required_fields": "evidence_note, claims, citations, uncertainty, verification_questions, source_notes"
    },
    {
      "from": "static-direction",
      "to": "copy-voice",
      "required_fields": "direction_contract, audience, copy_requirements"
    },
    {
      "from": "static-direction",
      "to": "image-prompting",
      "required_fields": "direction_contract, prompt_constraints, copy_requirements, text_layout_requirements, controlled_variants"
    },
    {
      "from": "motion-direction",
      "to": "copy-voice",
      "required_fields": "motion_direction, audience, VO_or_caption_needs"
    },
    {
      "from": "motion-direction",
      "to": "storyboard-architect",
      "required_fields": "motion_direction, timing_constraints, continuity_rules"
    },
    {
      "from": "storyboard-architect",
      "to": "copy-voice",
      "required_fields": "storyboard_contract, shot_context, VO_or_caption_needs"
    },
    {
      "from": "storyboard-architect",
      "to": "storyboard-board-architect",
      "required_fields": "storyboard_contract, visual_direction, panel_count, timing, label_requirements"
    },
    {
      "from": "storyboard-architect",
      "to": "video-prompting",
      "required_fields": "storyboard_contract, shot_cards, continuity_rules, timing_beats, required_continuity_carriers"
    },
    {
      "from": "storyboard-architect",
      "to": "hyperframes-producer",
      "required_fields": "storyboard_contract, timing, copy, render_constraints"
    },
    {
      "from": "storyboard-board-architect",
      "to": "image-prompting",
      "required_fields": "board_artifact_prompt, exact_board_text, panel_layout, safe_margins, acceptance_criteria"
    },
    {
      "from": "storyboard-board-architect",
      "to": "qa-iteration",
      "required_fields": "board_artifact_prompt, expected_observables, acceptance_criteria"
    },
    {
      "from": "copy-voice",
      "to": "research-evidence",
      "required_fields": "claims, author_context, source_rules, verification_questions, source_notes"
    },
    {
      "from": "copy-voice",
      "to": "qa-iteration",
      "required_fields": "copy_pack, copy_pack_status, author_context, fact_and_lock_ledger, human_voice_review, copy_delivery_loop, acceptance_criteria"
    },
    {
      "from": "qa-iteration",
      "to": "copy-voice",
      "required_fields": "QA_status, severity, root_cause, copy_delivery_loop_checks, regression_check, corrected_instruction_packets, stop_recommendation"
    },
    {
      "from": "copy-voice",
      "to": "image-prompting",
      "required_fields": "exact_copy, tone_notes, text_lock, text_hierarchy, safe_area"
    },
    {
      "from": "copy-voice",
      "to": "video-prompting",
      "required_fields": "VO, dialogue, supers, tone_notes, timing_locks, video_text_mode"
    },
    {
      "from": "copy-voice",
      "to": "hyperframes-producer",
      "required_fields": "captions, titles, VO, overlay_text, tone_notes"
    },
    {
      "from": "copy-voice",
      "to": "delivery-documentation",
      "required_fields": "final_text, copy_pack_status, author_context, human_voice_review, copy_delivery_loop, tone_notes, caveats"
    },
    {
      "from": "image-prompting",
      "to": "qa-iteration",
      "required_fields": "prompt_pack, creative_prompt_contract, content_checksum, reference_roles, attachment_plan, continuity_status, expected_observables, acceptance_criteria, selected_methods, verification_questions"
    },
    {
      "from": "image-prompting",
      "to": "tool-routing-cost",
      "required_fields": "prompt_pack, creative_prompt_contract, target_verification_status, asset_requirements, acceptance_criteria"
    },
    {
      "from": "video-prompting",
      "to": "qa-iteration",
      "required_fields": "prompt_pack, creative_prompt_contract, content_checksum, timing, reference_roles, attachment_plan, continuity_status, expected_observables, acceptance_criteria, selected_methods, verification_questions"
    },
    {
      "from": "video-prompting",
      "to": "tool-routing-cost",
      "required_fields": "prompt_pack, creative_prompt_contract, target_verification_status, timing, acceptance_criteria"
    },
    {
      "from": "tool-routing-cost",
      "to": "execution-manifest",
      "required_fields": "selected_tool, approval_status, required_inputs, creative_prompt_contract, adapter_verification, output_plan, risks"
    },
    {
      "from": "execution-manifest",
      "to": "asset-manifest",
      "required_fields": "output_files, params_summary, source_notes, adapter_verification, execution_evidence, redaction_status"
    },
    {
      "from": "hyperframes-producer",
      "to": "asset-manifest",
