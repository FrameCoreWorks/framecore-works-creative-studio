      ],
      "artifact": "Instruction Packet"
    },
    {
      "id": "direction_fit",
      "owners": [
        "static-direction",
        "motion-direction",
        "music-video-direction"
      ],
      "artifact": "Direction Contract"
    },
    {
      "id": "structure_fit",
      "owners": [
        "storyboard-architect"
      ],
