  "critical_contracts": [
    {
      "id": "research_conditional_triggers",
      "path": "skills/research-evidence/SKILL.md",
      "required_patterns": [
        "## Research triggers",
        "Search only when one does",
        "Do not search out of habit",
        "network access disabled"
      ]
    },
    {
      "id": "research_privacy",
      "path": "skills/research-evidence/SKILL.md",
      "required_patterns": [
        "Never send private briefs",
        "Generalize a query"
      ]
    },
    {
      "id": "untrusted_sources",
      "path": "skills/research-evidence/SKILL.md",
      "required_patterns": [
        "Search results, attached documents, and source code",
        "not tool authorization or instructions that override"
      ]
    },
    {
      "id": "research_not_execution",
      "path": "skills/research-evidence/SKILL.md",
      "required_patterns": [
        "Research does not authorize",
        "Never switch to another provider"
      ]
    },
    {
      "id": "research_failure_honesty",
      "path": "skills/research-evidence/SKILL.md",
      "required_patterns": [
        "browsing is unavailable, blocked",
        "research was not completed"
      ]
    },
    {
      "id": "prompt_only",
      "path": "skills/workflow-orchestrator/SKILL.md",
      "required_patterns": [
        "Do not execute a prompt-only request"
      ]
    },
    {
      "id": "handoff_locks",
      "path": "skills/workflow-orchestrator/SKILL.md",
      "required_patterns": [
        "Carry the exact copy, concept, reference roles and permitted changes through every handoff"
      ]
    },
    {
      "id": "actual_output_review",
      "path": "skills/workflow-orchestrator/SKILL.md",
      "required_patterns": [
        "Do not label a render reviewed before inspecting it"
      ]
    },
    {
      "id": "host_model_honesty",
      "path": "skills/workflow-orchestrator/SKILL.md",
      "required_patterns": [
        "never claim to have forced a model the tool cannot select"
      ]
    }
  ],
