{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:framecore:task-contract:1",
  "title": "FrameCore task contract, version 1",
  "description": "Shared request, result and capability-discovery shapes for Creative Studio, Toolbox and Open Assets. Each repository carries a byte-identical copy; no plugin imports another plugin's code.",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["succeeded", "partial", "needs_input", "needs_consent", "blocked", "refused", "failed", "cancelled"]},
    "readiness_state": {"enum": ["ready", "ready_full", "ready_light", "unlocked_legacy", "unavailable", "blocked_host"]},
    "origin": {"enum": ["studio", "standalone", "other"]},
    "party": {
      "type": "object",
      "required": ["plugin"],
      "properties": {
        "plugin": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"]},
        "skill": {"type": ["string", "null"]},
        "session": {"type": ["string", "null"]}
      }
    },
    "provider": {
      "type": "object",
      "required": ["plugin", "capability", "operation"],
      "properties": {
        "plugin": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"]},
        "capability": {"type": "string", "minLength": 1},
        "operation": {"type": "string", "minLength": 1},
        "command": {"type": ["string", "null"]}
      }
    },
    "input_file": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": ["integer", "null"], "minimum": 0},
        "role": {"type": ["string", "null"]},
        "provenance": {"type": ["object", "null"]}
      }
    },
    "output_file": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0},
        "media_kind": {"type": ["string", "null"]},
        "role": {"type": ["string", "null"]},
        "derived_from": {"type": "array", "items": {"$ref": "#/$defs/sha256"}},
        "sidecar": {"type": ["string", "null"]},
        "hash_source": {"enum": ["provider", "local_only", null]}
      }
    },
    "readiness": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": {"$ref": "#/$defs/readiness_state"},
        "command": {"type": ["string", "null"]},
        "observed_at": {"type": ["string", "null"]},
        "details": {"type": ["object", "null"]}
      }
    },
    "command_run": {
      "type": "object",
      "required": ["argv", "exit_code"],
      "properties": {
        "argv": {"type": "array", "items": {"type": "string"}},
        "exit_code": {"type": "integer"},
        "started": {"type": ["string", "null"]},
        "duration_s": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["check", "result"],
      "properties": {
        "check": {"type": "string", "minLength": 1},
        "result": {"enum": ["pass", "fail", "not_run"]},
        "scope": {"type": ["string", "null"]},
        "detail": {}
      }
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string"},
        "next_action": {"type": ["string", "null"]}
      }
    },
    "unexecuted": {
      "type": "object",
      "required": ["check", "reason"],
      "properties": {
        "check": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "request": {
      "type": "object",
      "required": ["contract", "task_id", "origin", "requester", "provider"],
      "properties": {
        "contract": {"const": "framecore-task-request/1"},
        "task_id": {"type": ["string", "null"]},
        "origin": {"$ref": "#/$defs/origin"},
        "requester": {"$ref": "#/$defs/party"},
        "owner": {"type": ["string", "null"]},
        "host": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "provider": {"$ref": "#/$defs/provider"},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/input_file"}},
        "parameters": {"type": "object"},
        "constraints": {"type": "object"},
        "consent": {"type": "object"},
        "acceptance": {"type": "array", "items": {"type": "string"}},
        "resume_of": {"type": ["string", "null"]},
        "return_to": {"type": ["object", "null"]}
      }
    },
    "result": {
      "type": "object",
      "required": ["contract", "task_id", "origin", "provider", "status", "host", "inputs", "outputs", "readiness",
                   "commands_run", "verification_evidence", "warnings", "errors", "unexecuted_checks"],
      "properties": {
        "contract": {"const": "framecore-task-result/1"},
        "task_id": {"type": ["string", "null"]},
        "origin": {"$ref": "#/$defs/origin"},
        "requester": {"anyOf": [{"$ref": "#/$defs/party"}, {"type": "null"}]},
        "owner": {"type": ["string", "null"]},
        "provider": {"$ref": "#/$defs/provider"},
        "status": {"$ref": "#/$defs/status"},
        "host": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/input_file"}},
        "outputs": {"type": "array", "items": {"$ref": "#/$defs/output_file"}},
        "readiness": {"$ref": "#/$defs/readiness"},
        "commands_run": {"type": "array", "items": {"$ref": "#/$defs/command_run"}},
        "verification_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "errors": {"type": "array", "items": {"$ref": "#/$defs/error"}},
        "unexecuted_checks": {"type": "array", "items": {"$ref": "#/$defs/unexecuted"}},
        "audio": {"type": ["object", "null"]},
        "asset": {"type": ["object", "null"]},
        "timing": {"type": ["object", "null"]}
      }
    },
    "capability": {
      "type": "object",
      "required": ["id", "kind", "operations", "readiness_command"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["built-in", "catalog"]},
        "operations": {"type": "array", "items": {"type": "string"}},
        "readiness_command": {"type": "string", "minLength": 1},
        "consent_required": {"type": "array", "items": {"type": "string"}},
        "network": {"type": "object"}
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["schema", "plugin", "entry_skill", "contract_versions", "contract_schema", "capabilities"],
      "properties": {
        "schema": {"const": "framecore-capabilities/1"},
        "plugin": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {"name": {"type": "string"}, "version": {"type": "string"}}
        },
        "entry_skill": {"type": "string", "minLength": 1},
        "contract_versions": {"type": "array", "items": {"enum": ["1"]}},
        "contract_schema": {
          "type": "object",
          "required": ["path", "sha256"],
          "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}
        },
        "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}}
      }
    }
  }
}
