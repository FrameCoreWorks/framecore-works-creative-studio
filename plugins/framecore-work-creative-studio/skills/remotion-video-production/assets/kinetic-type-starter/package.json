{
  "name": "framecore-kinetic-type-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node check-score.mjs motion-score.json",
    "storyboard": "node check-score.mjs motion-score.json --markdown",
    "studio": "remotion studio src/index.ts",
    "still": "remotion still src/index.ts KineticType out/frame-150.png --frame=150",
    "render": "remotion render src/index.ts KineticType out/kinetic-type.mp4",
    "render:9x16": "remotion render src/index.ts KineticType-9x16 out/kinetic-type-9x16.mp4",
    "render:1x1": "remotion render src/index.ts KineticType-1x1 out/kinetic-type-1x1.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.530",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.530"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  },
  "engines": {"node": ">=20"}
}
