{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framecoreworks.github.io/framecore-works-creative-studio/framecut/project-v1",
  "title": "FrameCut project v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "assets",
    "analyses",
    "sequences",
    "deliverables"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "brief": {
      "type": "object"
    },
    "authorization": {},
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "kind",
          "probe"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "enum": [
              "video",
              "image",
              "audio"
            ]
          },
          "probe": {
            "type": "object"
          }
        }
      }
    },
    "analyses": {
      "type": "object"
    },
    "sequences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "fps",
          "duration",
          "clips"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "fps": {
            "$ref": "#/$defs/rational"
          },
          "duration": {
            "type": "integer",
            "minimum": 1
          },
          "clips": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/event"
            }
          },
          "audio": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/event"
            }
          },
          "overlays": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/event"
            }
          },
          "texts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/event"
            }
          },
          "captions": {
            "type": "object"
          }
        }
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "sequence",
          "width",
          "height"
        ],
        "properties": {
          "framing": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "crop": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "fit": {
                  "enum": [
                    "contain",
                    "cover"
                  ]
                },
                "keyframes": {
                  "$ref": "#/$defs/animation"
                }
              }
            }
          }
        }
      }
    },
    "locks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "history": {
      "type": [
        "object",
        "null"
      ]
    },
    "status": {
      "type": "string"
    }
  },
  "$defs": {
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "num",
        "den"
      ],
      "properties": {
        "num": {
          "type": "integer",
          "minimum": 1
        },
        "den": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "duration"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "asset": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "duration": {
          "type": "integer",
          "minimum": 1
        },
        "source_in": {
          "type": "integer"
        },
        "speed": {
          "$ref": "#/$defs/rational"
        },
        "anchor": {
          "type": "object",
          "required": [
            "clip",
            "offset"
          ]
        },
        "keyframes": {
          "$ref": "#/$defs/animation"
        },
        "keyframe_offset": {
          "type": "integer",
          "minimum": 0
        },
        "source_remainder": {
          "type": "object",
          "required": [
            "num",
            "den"
          ],
          "properties": {
            "num": {
              "type": "integer",
              "minimum": 0
            },
            "den": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "freeze": {
          "type": "boolean"
        },
        "speed_curve": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "frame",
              "speed"
            ],
            "additionalProperties": false,
            "properties": {
              "frame": {
                "type": "integer",
                "minimum": 0
              },
              "speed": {
                "$ref": "#/$defs/rational"
              }
            }
          }
        },
        "effects": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": [
              "id",
              "version"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "params": {
                "type": "object"
              },
              "enabled": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "animation": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "x",
          "y",
          "scale",
          "rotation",
          "opacity",
          "gain_db",
          "zoom",
          "pan_x",
          "pan_y"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 128,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frame",
            "value"
          ],
          "properties": {
            "frame": {
              "type": "integer",
              "minimum": 0
            },
            "value": {
              "type": "number"
            },
            "easing": {
              "enum": [
                "linear",
                "smooth",
                "hold"
              ]
            }
          }
        }
      }
    }
  },
  "description": "Interchange shape. fc_core.validate enforces the closed fields, clocks, asset hashes, overlaps, source spans, anchors, bounds and revision semantics before any execution."
}
